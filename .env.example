# PostgreSQL connection string for the ServisPilot application role.
# Do not commit a real password. Copy this file to .env and replace the placeholder.
DATABASE_URL="postgresql://servispilot_app:change-me@127.0.0.1:5432/servispilot?schema=public"

# iron-session encryption password. At least 32 characters.
SESSION_PASSWORD="replace-with-at-least-32-random-characters"

# Uploaded files are stored outside the public web directory.
STORAGE_DIR="storage/uploads"
